	cd /root/env/build-docker && $(CMAKE_COMMAND) -P /root/env/build-docker/CMakeFiles/VerifyGlobs.cmake
	cd /root/env/build-docker && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
.PHONY : cmake_check_build_system

